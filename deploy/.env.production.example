# Copy to /opt/meeting-record/.env and edit.
#   sudo cp deploy/.env.production.example /opt/meeting-record/.env
#   sudo chmod 600 /opt/meeting-record/.env
#   sudo chown meeting-record:meeting-record /opt/meeting-record/.env

NODE_ENV=production

# API only on loopback — public traffic goes through Caddy
HOST=127.0.0.1
PORT=8787

APP_NAME=Meeting Record

# Bootstrap: true → register your one account → set false → restart API
ALLOW_REGISTER=false

# Long random string (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Data outside the git tree (backup this directory)
DATA_DIR=/var/lib/meeting-record
DATABASE_PATH=/var/lib/meeting-record/meeting-record.sqlite

MAX_RECORDING_MINUTES=60

# FunASR CPU sidecar (paths absolute on the server)
ASR_ENGINE=funasr
ASR_FALLBACK_MOCK=false
ASR_WORKER_PYTHON=/opt/meeting-record/workers/asr/.venv/bin/python
ASR_WORKER_SCRIPT=/opt/meeting-record/workers/asr/worker.py
ASR_WORKER_TIMEOUT_MS=1800000
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD=fsmn-vad
FUNASR_SPK=cam++
FUNASR_PUNC=ct-punc
FUNASR_DEVICE=cpu
FUNASR_HUB=ms

# Deploy-default LLM (OpenAI Chat Completions compatible)
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-id
LLM_API_KEY=sk-your-key

# PDF Chinese: path to a standalone .ttf/.otf (NOT .ttc)
# Example after: sudo apt install fonts-noto-cjk  (may only ship .ttc — prefer a .otf you place yourself)
# PDF_CJK_FONT=/usr/local/share/fonts/NotoSansSC-Regular.otf
