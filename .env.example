# Server
PORT=8787
APP_NAME=Meeting Record
# Registration gate — server only; never expose to frontend as a toggle
ALLOW_REGISTER=true
# SQLite path (relative to server cwd or absolute)
DATABASE_PATH=./data/meeting-record.sqlite
# Cookie session secret (change in production)
SESSION_SECRET=dev-session-secret-change-me
# Data root for media/exports
DATA_DIR=./data

# Capture
MAX_RECORDING_MINUTES=60

# ASR: mock (default, no Python) | funasr (not wired yet)
ASR_ENGINE=mock
MOCK_ASR_DELAY_MS=800

# Deploy-default LLM (OpenAI Chat Completions compatible)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Web (Vite) — leave empty in dev to use Vite proxy /api → :8787
VITE_API_BASE=
