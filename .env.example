# Server
# Bind address: 0.0.0.0 (dev) or 127.0.0.1 (prod behind reverse proxy)
HOST=0.0.0.0
PORT=8787
APP_NAME=Meeting Record
# Registration gate — server only; never expose to frontend as a toggle
ALLOW_REGISTER=true
# SQLite path (relative to server cwd or absolute)
DATABASE_PATH=./data/meeting-record.sqlite
# Cookie session secret (change in production)
SESSION_SECRET=dev-session-secret-change-me
# Data root for media/exports
DATA_DIR=./data

# Capture
MAX_RECORDING_MINUTES=60

# ASR: funasr (default, CPU FunASR sidecar) | mock (no Python)
ASR_ENGINE=funasr
ASR_FALLBACK_MOCK=false
MOCK_ASR_DELAY_MS=800
# FunASR worker (see workers/asr/README.md) — use absolute path on Windows if needed
ASR_WORKER_PYTHON=python
ASR_WORKER_SCRIPT=workers/asr/worker.py
ASR_WORKER_TIMEOUT_MS=1800000
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD=fsmn-vad
FUNASR_SPK=cam++
FUNASR_PUNC=ct-punc
# SenseVoice default vad_segment; override only if model has char timestamps
FUNASR_SPK_MODE=
FUNASR_DEVICE=cpu
FUNASR_HUB=ms

# Deploy-default LLM (OpenAI Chat Completions compatible)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Web (Vite) — leave empty in dev to use Vite proxy /api → :8787
VITE_API_BASE=

# PDF export: path to a CJK .ttf/.otf (optional; Windows auto-finds simhei/simfang/Deng)
# .ttc collections are not supported by pdf-lib
PDF_CJK_FONT=
